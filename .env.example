# Do not commit real keys.
# PowerShell one-time session example:
# $env:DATA_GO_KR_SERVICE_KEY="your-data-go-kr-service-key"
# $env:OPENDART_API_KEY="your-opendart-api-key"

DATA_GO_KR_SERVICE_KEY=
# 기업마당이 별도로 발급하는 키입니다. 나라장터 서비스키와 다릅니다.
BIZINFO_API_KEY=
OPENDART_API_KEY=

# Email sender configuration. Do not commit real credentials.
# Works with Gmail/Google Workspace, Microsoft 365, Daum, or another SMTP provider.
# Daum example: SMTP_HOST=smtp.daum.net, SMTP_PORT=465, SMTP_USE_SSL=true,
# SMTP_USERNAME/SMTP_FROM=your Daum address, SMTP_PASSWORD=Daum app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
